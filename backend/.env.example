# ════════════════════════════════════════════════════════════
# InternHub Backend — Environment Configuration
# Copy this to .env and fill in secrets
# NEVER commit .env to version control
# ════════════════════════════════════════════════════════════

# ─── Application ─────────────────────────────────────────────
APP_NAME=InternHub API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

# ─── Security ────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_WITH_GENERATED_SECRET_KEY
AES_MASTER_KEY=REPLACE_WITH_GENERATED_AES_KEY

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://internhub:internhub@localhost:5432/internhub
DB_ECHO=False
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://:internhub@localhost:6379/0

# ─── AWS S3 ──────────────────────────────────────────────────
S3_BUCKET=internhub-dev
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Email (SMTP) ────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@internhub.io

# ─── CORS (comma-separated for list) ─────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:5000"]

# ─── Monitoring ──────────────────────────────────────────────
SENTRY_DSN=
